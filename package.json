{
  "name": "ninja3js",
  "version": "0.3.0",
  "description": "Stylised ground mist, GPU fluid and ground-response effects for Three.js WebGPU (clean-room, FluidNinja-inspired).",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "docs/GROUND_FLOW_VOLUME.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "smoke:mist": "node tools/mist-smoke.mjs"
  },
  "peerDependencies": {
    "three": ">=0.184.0 <0.190.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@webgpu/types": "^0.1.72",
    "three": "0.185.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
